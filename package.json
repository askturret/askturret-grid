{
  "name": "@askturret/grid",
  "version": "0.2.2",
  "description": "High-performance React data grid with Rust/WASM. Server-side performance, zero server required.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./src/styles/grid.css": "./src/styles/grid.css",
    "./src/styles/orderbook.css": "./src/styles/orderbook.css",
    "./src/styles/topmovers.css": "./src/styles/topmovers.css",
    "./src/styles/timesales.css": "./src/styles/timesales.css",
    "./src/styles/positionladder.css": "./src/styles/positionladder.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "//build": "NOTE: When adding new CSS files, update both the cat command below AND exports in package.json",
    "build": "tsup && cat src/styles/grid.css src/styles/orderbook.css src/styles/topmovers.css src/styles/timesales.css src/styles/positionladder.css > dist/styles.css",
    "dev": "tsc --watch",
    "demo": "cd demo && npm run dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"demo/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"demo/src/**/*.{ts,tsx,css}\"",
    "size": "size-limit",
    "prepare": "husky",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.13"
  },
  "devDependencies": {
    "@size-limit/file": "^11.1.0",
    "@size-limit/preset-small-lib": "^11.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/browser": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "axe-core": "^4.10.2",
    "husky": "^9.1.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.2.0",
    "playwright": "^1.48.0",
    "prettier": "^3.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "size-limit": "^11.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "react",
    "grid",
    "datagrid",
    "table",
    "virtualization",
    "trading",
    "wasm",
    "webassembly",
    "performance"
  ],
  "license": "Apache-2.0",
  "author": "AskTurret",
  "repository": {
    "type": "git",
    "url": "https://github.com/askturret/askturret-grid"
  },
  "bugs": {
    "url": "https://github.com/askturret/askturret-grid/issues"
  },
  "homepage": "https://grid.askturret.com",
  "size-limit": [
    {
      "name": "Main bundle (JS)",
      "path": "dist/index.js",
      "limit": "30 KB",
      "gzip": true
    },
    {
      "name": "Styles (CSS)",
      "path": "dist/styles.css",
      "limit": "5 KB",
      "gzip": true
    },
    {
      "name": "WASM binary",
      "path": "wasm/pkg/askturret_grid_wasm_bg.wasm",
      "limit": "100 KB",
      "import": false
    }
  ],
  "lint-staged": {
    "*.{ts,tsx,css}": "prettier --write"
  }
}
